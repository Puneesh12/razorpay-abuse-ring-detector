# Copy to backend/.env. Both are optional -- the core detection pipeline
# (dataset, graph, classifier, policy engine) needs neither and never calls
# out to any API. Only the investigation assistant (app/core/investigate.py)
# uses one of these, and only when a reviewer actually asks it a question.
#
# If both are set, ANTHROPIC_API_KEY takes precedence (see investigate.py);
# that's not a capability ranking, just the order the if-chain checks.

ANTHROPIC_API_KEY=
GROQ_API_KEY=
